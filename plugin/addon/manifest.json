{
  "manifest_version": 2,
  "name": "Zotero中文社区",
  "version": "0.1.0",
  "description": "在 Zotero 里浏览、搜索、安装与更新 Zotero 中文社区(zoterocn.org)收录的插件。",
  "homepage_url": "https://zoterocn.org",
  "author": "Zotero 中文社区",
  "icons": {
    "32": "content/icons/icon-32.png",
    "64": "content/icons/icon-64.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-community@zoterocn.org",
      "update_url": "https://github.com/cnzotero/zotero-community/releases/download/release/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
