{
  "name": "zotero-community",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zotero 中文社区站:教程、插件广场、引用样式、问答讨论。账号与讨论后端后续接入,首版为内容驱动的静态站。",
  "scripts": {
